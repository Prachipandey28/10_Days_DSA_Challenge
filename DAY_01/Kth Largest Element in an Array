//leetcode - 215

class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        int n=nums.size();
        int ans = 0;
        for(int i = 0; i < k; i++) {
            int maxi = INT_MIN;
            int index = -1;
            for(int j = 0; j < n; j++) {
                if(nums[j] > maxi) {
                    maxi = nums[j];
                    index = j;
                }
            }
            ans = maxi;
            // Remove the maximum
            nums[index] = INT_MIN;
        }
        return ans;
    }
};
