class Solution {
public:
    int largestElement(vector<int>& nums) {
        int max=nums[0];
        int n=nums.size();
        if(n==0){
            return -1;
        }
        for(int i=0;i<n;i++){
            if(nums[i]>max){
                max=nums[i];
            }
            
        }
        return max;
    }
};
