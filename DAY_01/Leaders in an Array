class Solution {
public:
    vector<int> leaders(vector<int>& nums) {
        int n=nums.size();
        int maxcount=nums[n-1];
        vector<int>ans;
        ans.push_back(maxcount);
        for(int i=n-2;i>=0;i--){
            if(nums[i]>=maxcount){
                ans.push_back(nums[i]);
                maxcount=nums[i];
            }
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
};
