class Solution {
public:
    int secondLargestElement(vector<int>& nums) {
        //your code goes here
        int n=nums.size();
        set<int>s;
        for(int i=0;i<n;i++){
            s.insert(nums[i]);
        }
        nums.clear();
        for(auto x:s){
            nums.push_back(x);
        }
        sort(nums.begin(),nums.end());
        int v=nums.size();
        if(v<2){
            return -1;
        }
        else{
            return nums[v-2];
        }
    }
};
