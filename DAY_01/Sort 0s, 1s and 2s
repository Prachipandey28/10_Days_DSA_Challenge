class Solution {
public:
    void sortZeroOneTwo(vector<int>& nums) {
        // sort(nums.begin(),nums.end());
        int n=nums.size();
        for(int i=0;i<n;i++){
            for(int j=1;j<n;j++){
                if(nums[j-1]>nums[j]){
                swap(nums[j-1],nums[j]);
                }
            }
            
        }
  
    }
};
